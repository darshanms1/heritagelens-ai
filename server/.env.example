# ==============================================================================
# HeritageLens AI — Backend Environment Configuration (.env.example)
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# CORS Allowed Frontend Origin(s)
# Set to your production frontend domain (e.g. https://heritagelens.vercel.app)
# Supports a comma-separated list or * for open access
CLIENT_URL=https://your-frontend-domain.vercel.app

# Multimodal Vision AI Keys (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional External Database (Defaults to Bundled ASI Knowledge Bases)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/heritagelens
