# ==============================================================================
# HeritageLens AI — Root Environment Configuration (.env.example)
# DO NOT COMMIT SENSITIVE KEYS OR PASSWORDS TO GITHUB
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# CORS Allowed Frontend Origin(s)
# Set to your deployed frontend URL (e.g. https://heritagelens.vercel.app)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Multimodal AI Keys (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional External Database (Defaults to Bundled ASI Datasets)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/heritagelens
